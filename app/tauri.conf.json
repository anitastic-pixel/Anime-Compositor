{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anime Compositor",
  "version": "0.1.0",
  "identifier": "dev.anitastic.anime-compositor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Anime Compositor",
        "width": 1000,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://frame.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
