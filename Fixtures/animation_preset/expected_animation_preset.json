{
  "cases": {
    "FX-ANP-001": {
      "file": "fx_anp_001.fxpreset",
      "says": "Fade in applied at frame 10: its first key lands on frame 10, and the layer's own key at 40 stays.",
      "layer": "big",
      "at": 10,
      "expect": [
        {
          "path": "transform/opacity",
          "keys": [
            [
              10,
              0
            ],
            [
              22,
              1
            ],
            [
              40,
              0.5
            ]
          ]
        }
      ]
    },
    "FX-ANP-002": {
      "file": "fx_anp_002.fxpreset",
      "says": "Pop in on a 200 by 100 layer: the same numbers as on a 1920 by 1080 one, never scaled to the layer.",
      "layer": "small",
      "at": 10,
      "expect": [
        {
          "path": "transform/scale",
          "keys": [
            [
              10,
              [
                0,
                0
              ]
            ],
            [
              18,
              [
                110,
                110
              ]
            ],
            [
              22,
              [
                100,
                100
              ]
            ]
          ]
        }
      ]
    },
    "FX-ANP-003": {
      "file": "fx_anp_003.fxpreset",
