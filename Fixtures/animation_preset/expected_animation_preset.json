    "FX-ANP-011": {
      "file": "fx_anp_011.fxpreset",
      "says": "A mask goes on after the layer's own, its path and feather keys moved; a field this build does not know, `tension`, is kept with it and saved, never dropped.",
      "layer": "small",
      "at": 10,
      "expect": [
        {
          "path": "masks",
          "length": 1
