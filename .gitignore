# Rust
/target/
**/*.rs.bk

# Tauri / node
node_modules/
dist/
.tauri/

# Render trace and spike output (ADR-012) - diagnostic, never committed
trace/
spike-output/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Word review copies were removed in v0.3 (D-16). Markdown is the only source.
*.docx

# Rust build output from the quarantined G0 spikes
target/
spikes/*/gen/

# Cargo.lock is COMMITTED. ADR-005 requires it, and docs/DEPENDENCIES.md is generated from it,
# so an ignored lock would make the dependency record unreproducible.

# Standing instruction for the unattended overnight run; not part of the project.
NIGHT_RUN.md
MORNING_REPORT.md
DAY_RUN.md
DAY_REPORT.md

# Claude Code's own scratch state. The permission rules in .claude/settings.json are
# committed on purpose - they are project policy - but this lock file is per-session.
.claude/scheduled_tasks.lock

# Written by tauri-build on every build of the shell, from app/tauri.conf.json and the
# permissions of the crates in the graph. Regenerated, never edited, and it changes whenever a
# dependency does - committing it would mean a diff nobody wrote in most Tauri PRs.
app/gen/schemas/
