{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anime-compositor/project-v0.schema.json",
  "title": "Anime Compositor Project v0",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "color_settings",
    "assets",
    "compositions"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 0
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "color_settings": {
      "type": "object",
      "required": [
        "working_space",
        "alpha_mode"
      ],
      "properties": {
        "working_space": {
          "const": "linear-srgb"
        },
        "alpha_mode": {
          "const": "premultiplied"
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "compositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composition"
      }
    },
    "application_metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "propertyScalar": {
      "type": "object",
      "required": [
        "base",
        "keyframes"
      ],
      "properties": {
        "base": {
          "type": "number"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyScalar"
          }
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": false
    },
    "propertyVec2": {
      "type": "object",
      "required": [
        "base",
        "keyframes"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/vec2"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyVec2"
          }
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": false
    },
    "keyScalar": {
      "type": "object",
      "required": [
        "frame",
        "value",
        "interp"
      ],
      "properties": {
        "frame": {
          "type": "integer"
        },
        "value": {
          "type": "number"
        },
        "interp": {
          "enum": [
            "hold",
            "linear"
          ]
        }
      },
      "additionalProperties": false
    },
    "keyVec2": {
      "type": "object",
      "required": [
        "frame",
        "value",
        "interp"
      ],
      "properties": {
        "frame": {
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/vec2"
        },
        "interp": {
          "enum": [
            "hold",
            "linear"
          ]
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "anchor",
        "position",
        "scale",
        "rotation",
        "opacity"
      ],
      "properties": {
        "anchor": {
          "$ref": "#/$defs/propertyVec2"
        },
        "position": {
          "$ref": "#/$defs/propertyVec2"
        },
        "scale": {
          "$ref": "#/$defs/propertyVec2"
        },
        "rotation": {
          "$ref": "#/$defs/propertyScalar"
        },
        "opacity": {
          "$ref": "#/$defs/propertyScalar"
        }
      },
      "additionalProperties": false
    },
    "exposureSpan": {
      "type": "object",
      "required": [
        "start_frame",
        "end_frame_exclusive",
        "drawing_number"
      ],
      "properties": {
        "start_frame": {
          "type": "integer"
        },
        "end_frame_exclusive": {
          "type": "integer"
        },
        "drawing_number": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "mask": {
      "type": "object",
      "required": [
        "enabled",
        "inverted",
        "vertices"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "inverted": {
          "type": "boolean"
        },
        "vertices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/vec2"
          }
        }
      },
      "additionalProperties": false
    },
    "maskPoint": {
      "type": "object",
      "required": [
        "point"
      ],
      "properties": {
        "point": {
          "$ref": "#/$defs/vec2"
        },
        "in": {
          "$ref": "#/$defs/vec2"
        },
        "out": {
          "$ref": "#/$defs/vec2"
        }
      },
      "additionalProperties": false
    },
    "maskOutline": {
      "type": "object",
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maskPoint"
          }
        }
      },
      "additionalProperties": false
    },
    "maskPath": {
      "type": "object",
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/maskOutline"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "frame",
              "value"
            ],
            "properties": {
              "frame": {
                "type": "integer"
              },
              "value": {
                "$ref": "#/$defs/maskOutline"
              },
              "interp": {
                "enum": [
                  "hold",
                  "linear",
                  "ease"
                ]
              },
              "ease": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "maskRecord": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "inverted": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "add",
            "subtract",
            "intersect",
            "difference",
            "none"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "feather_px": {
          "type": "number",
          "minimum": 0
        },
        "expansion_px": {
          "type": "number",
          "minimum": -8192,
          "maximum": 8192
        },
        "path": {
          "$ref": "#/$defs/maskPath"
        }
      },
      "additionalProperties": false
    },
    "matte": {
      "type": "object",
      "required": [
        "layer_id",
        "mode"
      ],
      "properties": {
        "layer_id": {
          "type": "string"
        },
        "mode": {
          "const": "alpha"
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "instance_id",
        "type_id",
        "enabled",
        "parameters"
      ],
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "type_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "enabled",
        "locked",
        "in_frame",
        "out_frame"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "not": {
            "required": [
              "mask",
              "masks"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "raster"
              }
            }
          },
          "then": {
            "required": [
              "asset_id",
              "source_offset_frames"
            ],
            "not": {
              "required": [
                "composition_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "adjustment"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset_id"
                  ]
                },
                {
                  "required": [
                    "composition_id"
                  ]
                }
              ]
            },
            "properties": {
              "blend_mode": {
                "const": "normal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "composition"
              }
            }
          },
          "then": {
            "required": [
              "composition_id",
              "source_offset_frames"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset_id"
                  ]
                },
                {
                  "required": [
                    "exposure_spans"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "audio"
              }
            }
          },
          "then": {
            "required": [
              "asset_id",
              "source_offset_frames"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "transform"
                  ]
                },
                {
                  "required": [
                    "exposure_spans"
                  ]
                },
                {
                  "required": [
                    "mask"
                  ]
                },
                {
                  "required": [
                    "masks"
                  ]
                },
                {
                  "required": [
                    "matte"
                  ]
                },
                {
                  "required": [
                    "blend_mode"
                  ]
                },
                {
                  "required": [
                    "effects"
                  ]
                },
                {
                  "required": [
                    "parent"
                  ]
                },
                {
                  "required": [
                    "depth"
                  ]
                },
                {
                  "required": [
                    "composition_id"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "transform",
              "blend_mode",
              "effects"
            ],
            "not": {
              "required": [
                "gain_db"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "solid"
              }
            }
          },
          "then": {
            "required": [
              "solid"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset_id"
                  ]
                },
                {
                  "required": [
                    "composition_id"
                  ]
                },
                {
                  "required": [
                    "exposure_spans"
                  ]
                },
                {
                  "required": [
                    "source_offset_frames"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "solid"
              ]
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "raster",
            "adjustment",
            "composition",
            "audio",
            "solid"
          ]
        },
        "name": {
          "type": "string"
        },
        "solid": {
          "type": "object",
          "description": "D-74: a solid layer's drawing, width by height pixels of one colour, opaque.",
          "required": [
            "color",
            "width",
            "height"
          ],
          "additionalProperties": true,
          "properties": {
            "color": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          }
        },
        "asset_id": {
          "type": "string"
        },
        "composition_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "in_frame": {
          "type": "integer"
        },
        "out_frame": {
          "type": "integer"
        },
        "source_offset_frames": {
          "type": "integer"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "exposure_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exposureSpan"
          }
        },
        "mask": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/mask"
            }
          ]
        },
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maskRecord"
          }
        },
        "matte": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/matte"
            }
          ]
        },
        "depth": {
          "$ref": "#/$defs/propertyScalar"
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "blend_mode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "gain_db": {
          "type": "number",
          "minimum": -96,
          "maximum": 12,
          "description": "D-71: the level of an audio layer in decibels. 0 when absent."
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "width",
        "height",
        "pixel_aspect_ratio",
        "frame_rate",
        "start_frame",
        "duration_frames",
        "layer_order",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_aspect_ratio": {
          "const": 1
        },
        "frame_rate": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "start_frame": {
          "type": "integer"
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "work_area": {
          "type": "object",
          "properties": {
            "start_frame": {
              "type": "integer"
            },
            "end_frame_exclusive": {
              "type": "integer"
            }
          },
          "required": [
            "start_frame",
            "end_frame_exclusive"
          ],
          "additionalProperties": false
        },
        "camera": {
          "type": "object",
          "required": [
            "position",
            "depth",
            "zoom"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/propertyVec2"
            },
            "depth": {
              "$ref": "#/$defs/propertyScalar"
            },
            "zoom": {
              "$ref": "#/$defs/propertyScalar"
            }
          },
          "additionalProperties": false
        },
        "layer_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "still",
            "image_sequence",
            "audio"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "redistribute": {
          "type": "boolean",
          "description": "D-61: false when the artist may not pass the asset's drawings on in a package. Written only when false."
        },
        "frames": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interpretation": {
          "type": "object",
          "required": [
            "color_space",
            "alpha"
          ],
          "properties": {
            "color_space": {
              "enum": [
                "srgb",
                "linear-srgb"
              ]
            },
            "alpha": {
              "enum": [
                "straight",
                "premultiplied"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "audio"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          },
          "else": {
            "required": [
              "interpretation"
            ]
          }
        }
      ]
    },
    "expression": {
      "type": "object",
      "required": [
        "text",
        "enabled"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
